---
import i18next, { t, changeLanguage } from "i18next";
import Layout from "../layouts/Layout.astro";
import { areasExperiencia } from "../data/constants_areasexperiencia.js";

changeLanguage("es");

const currentLanguage = i18next.language;
---

<Layout>
  <main class='min-h-screen'>

    <!-- Hero Section -->
    <section class='relative bg-[#06439C] py-10 px-4 overflow-hidden'>
      <div class='absolute inset-0 bg-gradient-to-r from-[#06439C] via-[#355282] to-[#06439C] opacity-90'></div>
      <div class='absolute top-0 right-0 w-64 h-64 md:w-96 md:h-96 bg-amber-500/20 rounded-full blur-3xl'></div>
      <div class='absolute bottom-0 left-0 w-64 h-64 md:w-96 md:h-96 bg-amber-600/10 rounded-full blur-3xl'></div>

      <div class='container mx-auto relative z-10'>
        <div class='grid md:grid-cols-2 gap-10 items-center'>

          <!-- Hero Image -->
          <div class='relative rounded-2xl overflow-hidden aspect-[4/3] order-2 md:order-1'>
            <img
              src='/img/deutsche-messe-areas.webp'
              alt='deutsche-messe-areas'
              class='w-full h-full object-cover'
            />
          </div>

          <!-- Hero Content -->
          <div class='text-center md:text-left order-1 md:order-2'>
            <div class='mb-8'>
              <span class='inline-block bg-white/10 backdrop-blur-sm px-8 rounded-full text-xl p-2 font-semibold tracking-widest text-white border border-white/20'>
                Deutsche Messe
              </span>
            </div>
            <h1 class='text-5xl md:text-7xl font-black mb-8 leading-tight text-white drop-shadow-lg'>
              {t('AreasExpertise.title')}
            </h1>
            <div class='max-w-4xl mx-auto md:mx-0'>
              <p class='text-xl md:text-2xl leading-relaxed text-white/95 font-light text-justify'>
                {t('AreasExpertise.text')}
              </p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Grid Section -->
    <section class='w-full bg-gradient-to-br from-gray-50 to-white py-20'>
      <div class='container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl'>

        <!-- Section Title -->
        <div class='text-center mb-8 sm:mb-12'>
          <p class='text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black text-[#355282] tracking-tight'>
            {t('AreasExpertise.title')}
          </p>
        </div>

        <!-- Cards Grid -->
        <div class='grid gap-8 grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 auto-rows-max'>
          {areasExperiencia.map((area) => (
            <div class='group h-full'>
              
              <!-- Individual Card Container -->
              <div class='bg-gradient-to-br from-slate-50 to-slate-100 p-0 rounded-3xl border border-slate-200 hover:border-amber-300 hover:shadow-xl transition-all duration-300 h-full flex flex-col overflow-hidden relative group'>

                <!-- Card Header (Image) -->
                <div class='relative h-48 sm:h-56 md:h-64 overflow-hidden'>
                  <img
                    src={area.image}
                    alt={area.title}
                    class='w-full h-full object-cover transition-transform duration-700 group-hover:scale-110'
                  />
                  <div class='absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent'></div>
                  <span class='absolute top-3 right-3 inline-flex items-center gap-1 bg-gradient-to-r from-[#355282] to-blue-600 text-white px-3 py-1 rounded-full text-xs font-bold shadow-md'>
                    {area.links.length} {area.links.length === 1 ? 'feria' : 'ferias'}
                  </span>
                </div>

                <!-- Card Body (Text) -->
                <div class='p-4 sm:p-5 md:p-6 lg:p-7 flex flex-col flex-1'>
                  <h3 class='font-bold text-lg sm:text-xl md:text-2xl text-gray-900 leading-tight mb-3 group-hover:text-amber-600 transition-colors duration-300'>
                    {currentLanguage === "en" ? area.title_en : area.title}
                  </h3>

                  <div class='text-gray-600 text-xs sm:text-sm leading-relaxed mb-4 text-justify flex-1'>
                    {currentLanguage === "en" ? (
                      <p set:html={area.text_en} />
                    ) : (
                      <p set:html={area.text} />
                    )}
                  </div>

                  <!-- Card Footer (Details) -->
                  <div class='pt-3 border-t border-gray-200/80'>
                    <details class="group/details">
                      <summary class='flex items-center justify-between cursor-pointer list-none text-sm font-semibold text-[#355282] hover:text-amber-600 transition-colors duration-200'>
                        <span>{t('AreasExpertise.see_fairs')}</span>
                        <svg class='w-4 h-4 transition-transform duration-300 group-open/details:rotate-180' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='2.5'>
                          <path stroke-linecap='round' stroke-linejoin='round' d='M19 9l-7 7-7-7'/>
                        </svg>
                      </summary>
                      <!-- Links List -->
                      <ul class='mt-2 flex flex-col gap-0.5'>
                        {area.links.map((link) => (
                          <li>
                            <a
                              href={link.href}
                              target='_blank'
                              rel='noreferrer'
                              class='flex items-center gap-2 py-1.5 px-2 rounded-lg text-xs sm:text-sm text-gray-600 hover:text-amber-600 hover:bg-amber-50 transition-colors duration-150'
                            >
                              <span class='w-1.5 h-1.5 rounded-full bg-amber-500 flex-shrink-0'></span>
                              <span class='flex-1'>{link.name}</span>
                              <svg class='w-3.5 h-3.5 flex-shrink-0 text-gray-300' viewBox='0 0 12 12' fill='none'>
                                <path d='M2.5 9.5L9.5 2.5M9.5 2.5H5M9.5 2.5V7' stroke='currentColor' stroke-width='1.4' stroke-linecap='round' stroke-linejoin='round'/>
                              </svg>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </details>
                  </div>
                </div>

                <div class='absolute inset-0 rounded-3xl pointer-events-none border-2 border-transparent group-hover:border-amber-300/40 transition-colors duration-500'></div>
              </div>
            </div>
          ))}

