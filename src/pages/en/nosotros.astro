---
import i18next, { t, changeLanguage } from "i18next";
import Layout from "../../layouts/Layout.astro";
import { constans_persons } from "../../data/constans_persons";

changeLanguage("en");

const currentLanguage = i18next.language;
---

<Layout>
  <main class='min-h-screen bg-white'>
    <!-- Hero Section -->
    <section class='relative overflow-hidden bg-[#292725] px-4 py-12 sm:px-6 sm:py-16 lg:py-8'>
      <!-- Decorative background elements -->
      <div class='absolute inset-0 bg-[#292725] opacity-95'></div>
      <div class='absolute inset-x-0 bottom-0 h-px bg-white/20'></div>
      <div class='relative z-10 mx-auto max-w-4xl text-center'>
        <h1 class='mx-auto mb-5 max-w-3xl text-3xl font-black leading-tight text-white sm:text-4xl md:text-5xl'>
          {t('AboutUs.title')}
        </h1>
        <div class='mx-auto mt-5 max-w-2xl'>
          <p class='about-copy text-sm leading-7 text-white/90 font-light sm:text-base md:text-lg' set:html={t('AboutUs.text')} />
        </div>
      </div>
    </section>

    <!-- Team Section -->
    <section class='mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:py-20'>
      <div class='grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3'>
        {
          constans_persons.map((person) => (
            <article class='group h-full rounded-md border border-gray-200 bg-white p-6 text-center shadow-sm transition duration-300 hover:-translate-y-1 hover:border-[#355282]/40 hover:shadow-md'>
              <div class='mb-5 flex justify-center'>
                <img
                  src={person.image}
                  alt={person.name}
                  class='h-28 w-28 rounded-full border-4 border-[#06439C]/10 object-cover object-top shadow-sm transition duration-300 group-hover:border-[#06439C]/20 sm:h-32 sm:w-32'
                />
              </div>
              
              <div>
                <h3 class='mb-2 text-lg font-bold leading-snug text-[#355282]'>
                  {person.name}
                </h3>
                <p class='mx-auto max-w-64 text-sm font-medium leading-6 text-gray-600'>
                  {currentLanguage === 'en'
                    ? person.position_en
                    : person.position}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</Layout>

<style>
  .about-copy {
    text-wrap: pretty;
  }
</style>
