---
import i18next, { t, changeLanguage } from "i18next";
import Layout from "../layouts/Layout.astro";
import { constans_persons } from "../data/constans_persons";

changeLanguage("es");

const currentLanguage = i18next.language;
---

<Layout>
  <main class='min-h-screen'>
    <!-- Hero Section -->
    <section class='relative bg-[#06439C] px-4 py-12 sm:px-6 sm:py-16 lg:py-20 overflow-hidden'>
      <!-- Decorative background elements -->
      <div class='absolute inset-0 bg-gradient-to-r from-[#06439C] via-[#355282] to-[#06439C] opacity-90'></div>
      <div class='relative z-10 mx-auto max-w-6xl text-center'>
        <div class='mb-6 sm:mb-8'>
          <span class='inline-flex max-w-full items-center justify-center rounded-full bg-white/10 px-4 py-2 text-sm font-semibold tracking-[0.18em] text-white border border-white/20 backdrop-blur-sm sm:px-8 sm:text-xl sm:tracking-widest'>
            Deutsche Messe
          </span>
        </div>
        <h1 class='mb-5 text-4xl font-black leading-tight text-white drop-shadow-lg sm:mb-8 sm:text-5xl md:text-6xl lg:text-7xl'>
          {t('AboutUs.title')}
        </h1>
        <div class='max-w-4xl mx-auto'>
          <p class='text-base leading-relaxed text-white/95 font-light sm:text-lg md:text-xl lg:text-2xl' set:html={t('AboutUs.text')} />
        </div>
      </div>
    </section>

    <!-- Team Section -->
    <section class='mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:py-20'>
      <div class='grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3'>
        {
          constans_persons.map((person) => (
            <div class='mx-auto w-full max-w-80'>
              <div class='flex justify-center mb-4'>
                <img
                  src={person.image}
                  alt={person.name}
                  class='h-36 w-36 rounded-full object-cover object-top shadow-lg sm:h-44 sm:w-44 md:h-48 md:w-48'
                />
              </div>
              
              <div class='text-center'>
                <h3 class='mb-2 text-xl font-bold text-[#355282] sm:text-2xl'>
                  {person.name}
                </h3>
                <p class='text-sm font-medium leading-relaxed text-gray-600 sm:text-base'>
                  {currentLanguage === 'en'
                    ? person.position_en
                    : person.position}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </main>
</Layout>
