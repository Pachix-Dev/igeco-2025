---
import { alliesStrategic, media_1 } from "../data/constans_aliados";
import { t } from "i18next";

const groups = [
  { title: t("home.title_ally"), logos: alliesStrategic },
  { title: t("home.title_media"), logos: media_1 },
];
---

<div class="mx-auto w-full max-w-7xl space-y-12 px-4 py-10 sm:space-y-16 sm:px-6 sm:py-14 lg:px-8">
  {
    groups.map(({ title, logos }) => (
      <section>
        <h2 class="mb-6 text-center text-2xl leading-tight font-extrabold text-[#355282] uppercase sm:mb-8 sm:text-3xl lg:text-4xl">
          {title}
        </h2>
        <ul
          role="list"
          class="m-0 grid list-none grid-cols-3 gap-3 p-0 sm:grid-cols-3 sm:gap-4 md:grid-cols-4 lg:gap-6 xl:grid-cols-6"
          data-aos="fade-up"
          data-aos-duration="1500"
        >
          {logos.map((ally) => {
            const Tag = ally.link ? "a" : "div";

            return (
              <li class="min-w-0">
                <Tag
                  class:list={[
                    "flex h-16 w-full items-center justify-center rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:h-28 sm:p-4",
                    ally.link &&
                      "transition-[border-color,box-shadow] hover:border-[#355282] hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#355282] motion-reduce:transition-none",
                  ]}
                  href={ally.link || undefined}
                  target={ally.link ? "_blank" : undefined}
                  rel={ally.link ? "noopener noreferrer" : undefined}
                >
                  <img
                    src={ally.src}
                    alt={ally.alt}
                    class="block h-full max-h-20 w-full max-w-44 object-contain sm:max-h-24"
                    loading="lazy"
                    decoding="async"
                  />
                </Tag>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }
</div>
